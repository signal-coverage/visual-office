{
  "name": "visual-office",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n web,game,voice -c cyan,magenta,yellow \"npm:dev\" \"npm:server\" \"npm:livekit\"",
    "init": "npm run dev:all",
    "livekit": "node scripts/livekit.mjs",
    "start": "node server/index.ts",
    "check:company": "node scripts/check-company.mjs",
    "invite": "node scripts/invite.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:check": "node scripts/backup-check.mjs",
    "format": "prettier --write . && prettier --check .",
    "prepare": "husky || echo Skipping git hooks: husky is not installed"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@clerk/react": "^6.17.8",
    "@colyseus/schema": "^5.0.36",
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/ws-transport": "^0.18.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "colyseus": "^0.18.9",
    "livekit-client": "^2.22.4",
    "livekit-server-sdk": "^2.19.1",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@locator/babel-jsx": "^0.5.1",
    "@locator/runtime": "^0.5.1",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "3.9.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
